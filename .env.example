# 复制为 .env（已被 .gitignore 排除），或直接在 shell 中 export。
# 下列值均为占位示例，请勿在公开仓库中写入真实口令。

# Flask 会话密钥
THESIS_SECRET_KEY=change-this-to-a-random-string

# 演示账号（init_db.py 会据此生成口令哈希）
THESIS_ADMIN_USER=admin
THESIS_ADMIN_PWD=ChangeMe_Admin
THESIS_DEMO_USER=demo
THESIS_DEMO_PWD=ChangeMe_Demo

# 数据库后端：sqlite（默认，开箱即用）| mysql
THESIS_DB_BACKEND=sqlite
THESIS_MYSQL_USER=thesis_app
THESIS_MYSQL_PASSWORD=CHANGE_ME
THESIS_MYSQL_RO_USER=thesis_ro
THESIS_MYSQL_RO_PASSWORD=CHANGE_ME

# 非 Windows 平台运行截图脚本时，指向本机 Chrome/Chromium 可执行文件
# CHROME_PATH=/usr/bin/google-chrome
